# PropToIt sample stack configuration.
#
# `make dev` GENERATES a real .env with fresh random secrets — you normally
# never edit it. This file documents the variables for manual setups only.
# Copy to .env and fill in if you want fixed credentials:
#
#     cp .env.example .env
#
# NEVER commit a real .env (gitignored).

# --- Postgres (sample stack, host port 5437) ---
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32

# --- Meilisearch (host port 7707); 32 bytes hex for v1.x ---
MEILI_MASTER_KEY=change-me-openssl-rand-hex-32

# --- Host ports (defaults live in the Makefile; override here if taken) ---
# POSTGRES_HOST_PORT=5437
# MEILI_HOST_PORT=7707

# --- Image overrides (defaults in docker-compose.yml) ---
# POSTGRES_IMAGE=postgres:16-alpine          # default; multi-arch
# POSTGRES_IMAGE=postgis/postgis:16-3.4     # amd64 hosts only (no arm64 build)
# MEILI_IMAGE=getmeili/meilisearch:v1.11
